# =============================================================================
# Personal Knowledge-Base MCP Server — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# .env is listed in .gitignore and must NEVER be committed to the repository.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN=http://localhost:3000

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# ── Embeddings ────────────────────────────────────────────────────────────────
# Supported providers: openai | huggingface | cohere
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
